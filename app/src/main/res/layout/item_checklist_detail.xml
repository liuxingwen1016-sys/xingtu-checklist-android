<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorDivider"
    app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/itemCheck" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/cd_item_checkbox" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/itemTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="@color/colorTextPrimary" />
                <TextView android:id="@+id/importantTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_important_tag" android:paddingHorizontal="7dp" android:paddingVertical="2dp" android:text="@string/item_important" android:textColor="@color/colorSecondary" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/categoryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceLabelSmall" android:textColor="@color/colorPrimary" />
            <TextView android:id="@+id/itemNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/colorTextSecondary" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/editItemButton" style="@style/Widget.Material3.Button.IconButton" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/item_edit_title_edit" app:icon="@drawable/ic_edit" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deleteItemButton" style="@style/Widget.Material3.Button.IconButton" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/action_delete" app:icon="@drawable/ic_delete" app:iconTint="@color/colorError" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
