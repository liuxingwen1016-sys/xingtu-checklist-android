<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_lg">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:rotation="180" android:contentDescription="@string/action_back" app:icon="@drawable/ic_chevron_right" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/lab_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/lab_section_device" android:textColor="@color/colorTextSecondary" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/colorSurface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/colorDivider" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <include layout="@layout/item_lab_device_row" android:id="@+id/osRow" />
                <TextView android:id="@+id/osValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/colorTextPrimary" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/lab_device_model" android:textColor="@color/colorTextSecondary" /><TextView android:id="@+id/modelValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/lab_window_size" android:textColor="@color/colorTextSecondary" /><TextView android:id="@+id/windowValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/lab_theme_mode" android:textColor="@color/colorTextSecondary" /><TextView android:id="@+id/themeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/lab_notification_status" android:textColor="@color/colorTextSecondary" /><TextView android:id="@+id/notificationValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xl" android:text="@string/lab_section_actions" android:textColor="@color/colorTextSecondary" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/notificationAction" android:layout_width="0dp" android:layout_height="150dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="18dp" app:strokeColor="@color/colorDivider" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="12dp"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_notification" app:tint="@color/colorPrimary"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/lab_action_notification" android:textStyle="bold"/><TextView android:id="@+id/notificationState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/lab_state_ready" android:textColor="@color/colorSuccess"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/vibrationAction" android:layout_width="0dp" android:layout_height="150dp" android:layout_marginStart="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="18dp" app:strokeColor="@color/colorDivider" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="12dp"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_vibration" app:tint="@color/colorSecondary"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/lab_action_vibration" android:textStyle="bold"/><TextView android:id="@+id/vibrationState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/lab_state_ready" android:textColor="@color/colorSuccess"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/shareAction" android:layout_width="0dp" android:layout_height="150dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="18dp" app:strokeColor="@color/colorDivider" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="12dp"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_share" app:tint="@color/colorSuccess"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/lab_action_share" android:textStyle="bold"/><TextView android:id="@+id/shareState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/lab_state_ready" android:textColor="@color/colorSuccess"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/widgetAction" android:layout_width="0dp" android:layout_height="150dp" android:layout_marginStart="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="18dp" app:strokeColor="@color/colorDivider" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="12dp"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" android:src="@drawable/ic_widget_grid" app:tint="@color/colorPrimary"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/lab_action_widget" android:textStyle="bold"/><TextView android:id="@+id/widgetState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/lab_state_ready" android:textColor="@color/colorSuccess"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/rerunButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="@dimen/space_xl" android:text="@string/lab_rerun_detect" />
        <Space android:layout_width="1dp" android:layout_height="24dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
